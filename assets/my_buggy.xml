<mujoco model="maze_buggy">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.005"/>

  <worldbody>
    <body name="buggy" pos="0 0 0.03">
      <freejoint name="root"/>

      <geom name="chassis" type="box" size="0.06 0.048 0.015" mass="0.35" priority="1"
            friction="0.02 0.001 0.0001" rgba="0.15 0.45 0.85 1"/>

      <geom name="front_skid" type="sphere" pos="0.050 0 -0.0195" size="0.010" mass="0.01" priority="1"
            friction="0.005 0.001 0.0001" rgba="0.5 0.5 0.5 1"/>
      <geom name="rear_skid"  type="sphere" pos="-0.050 0 -0.0195" size="0.010" mass="0.01" priority="1"
            friction="0.005 0.001 0.0001" rgba="0.5 0.5 0.5 1"/>

      <geom name="left_guard"  type="capsule" pos="0.01 0.0715 0.0"  size="0.0025 0.030" euler="0 90 0" mass="0.005" priority="1"
            friction="0.01 0.001 0.0001" rgba="0.3 0.3 0.3 0.8"/>
      <geom name="right_guard" type="capsule" pos="0.01 -0.0715 0.0" size="0.0025 0.030" euler="0 90 0" mass="0.005" priority="1"
            friction="0.01 0.001 0.0001" rgba="0.3 0.3 0.3 0.8"/>

      <site name="imu" pos="0 0 0" size="0.005" rgba="0 1 0 1"/>

      <site name="prox_front" pos="0.062 0 0"       zaxis="1 0 0"  size="0.004" rgba="1 0 0 1"/>
      <site name="prox_back"  pos="-0.062 0 0"      zaxis="-1 0 0" size="0.004" rgba="1 0 0 1"/>
      <site name="prox_left"  pos="0 0.075 0.025"   zaxis="0 1 0"  size="0.004" rgba="1 0 0 1"/>
      <site name="prox_right" pos="0 -0.075 0.025"  zaxis="0 -1 0" size="0.004" rgba="1 0 0 1"/>
      <site name="prox_fl"    pos="0.05 0.06 0"     zaxis="1 1 0"  size="0.004" rgba="1 0.5 0 1"/>
      <site name="prox_fr"    pos="0.05 -0.06 0"    zaxis="1 -1 0" size="0.004" rgba="1 0.5 0 1"/>

      <body name="left_wheel" pos="0.01 0.06 0">
        <joint name="left_wheel_joint" type="hinge" axis="0 1 0" damping="0.002" armature="0.005"/>
        <geom name="left_wheel_geom" type="cylinder" size="0.03 0.008" euler="90 0 0" mass="0.05"
              friction="1.0 0.005 0.0001" rgba="0.1 0.1 0.1 1"/>
      </body>

      <body name="right_wheel" pos="0.01 -0.06 0">
        <joint name="right_wheel_joint" type="hinge" axis="0 1 0" damping="0.002" armature="0.005"/>
        <geom name="right_wheel_geom" type="cylinder" size="0.03 0.008" euler="90 0 0" mass="0.05"
              friction="1.0 0.005 0.0001" rgba="0.1 0.1 0.1 1"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="left_vel"  joint="left_wheel_joint"  kv="0.05" ctrlrange="-30 30" forcerange="-0.5 0.5"/>
    <velocity name="right_vel" joint="right_wheel_joint" kv="0.05" ctrlrange="-30 30" forcerange="-0.5 0.5"/>
  </actuator>

  <sensor>
    <jointvel name="enc_left_vel"  joint="left_wheel_joint"/>
    <jointvel name="enc_right_vel" joint="right_wheel_joint"/>
    <gyro     name="gyro"          site="imu"/>

    <rangefinder name="rf_front" site="prox_front" cutoff="1.2"/>
    <rangefinder name="rf_back"  site="prox_back"  cutoff="1.2"/>
    <rangefinder name="rf_left"  site="prox_left"  cutoff="1.2"/>
    <rangefinder name="rf_right" site="prox_right" cutoff="1.2"/>
    <rangefinder name="rf_fl"    site="prox_fl"    cutoff="1.2"/>
    <rangefinder name="rf_fr"    site="prox_fr"    cutoff="1.2"/>
  </sensor>
</mujoco>